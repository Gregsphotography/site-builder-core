{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:laravel-site-builder:render-envelope:1",
  "title": "Site Builder registered render envelope v1",
  "description": "Semantic admission requires registered feature/theme versions, scope controls, breakpoints, option membership, combinations, matching published assets and a pinned owner-level design context. Unknown features remain opaque/read-only.",
  "type": "object",
  "required": [
    "version"
  ],
  "minProperties": 2,
  "properties": {
    "version": {
      "const": 1
    },
    "design": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "version"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "base": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              }
            },
            "responsive": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                "not": {
                  "const": "base"
                }
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "version",
            "theme"
          ],
          "additionalProperties": false,
          "properties": {
            "version": {
              "const": 1
            },
            "base": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_-]{0,63}$"
              },
              "additionalProperties": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
              }
            },
            "responsive": {
              "type": "object",
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_-]{0,31}$",
                "not": {
                  "const": "base"
                }
              },
              "additionalProperties": {
                "type": "object",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9_-]{0,63}$"
                },
                "additionalProperties": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
                }
              }
            },
            "theme": {
              "type": "object",
              "required": [
                "id",
                "version",
                "preset"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                },
                "preset": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
                }
              }
            }
          }
        }
      ]
    },
    "composition": {
      "type": "object",
      "required": [
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "header": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/publishedPartReference"
            }
          ]
        },
        "footer": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/publishedPartReference"
            }
          ]
        },
        "siteDesign": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/publishedPartReference"
            }
          ]
        }
      }
    }
  },
  "additionalProperties": {
    "type": "object",
    "required": [
      "version"
    ],
    "properties": {
      "version": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "$defs": {
    "publishedPartReference": {
      "type": "object",
      "required": [
        "resourceId",
        "revisionId",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "resourceId": {
          "type": "string",
          "format": "uuid"
        },
        "revisionId": {
          "type": "string",
          "format": "uuid"
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
