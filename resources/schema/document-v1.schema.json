{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:laravel-site-builder:document:1",
  "title": "Laravel Site Builder document version 1",
  "description": "Structural design contract. Component semantics, unique IDs, locale configuration and depth/size limits require application validation.",
  "type": "object",
  "required": ["format", "version", "nodes", "extensions"],
  "properties": {
    "format": { "const": "laravel-site-builder/document" },
    "version": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "extensions": { "$ref": "#/$defs/object" }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonValue": {
      "oneOf": [
        { "type": ["string", "number", "boolean", "null"] },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "$ref": "#/$defs/object" }
      ]
    },
    "object": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/jsonValue" }
    },
    "node": {
      "type": "object",
      "required": ["id", "type", "version", "props", "translations", "visibility", "children", "extensions"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "type": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,99}$"
        },
        "version": { "type": "integer", "minimum": 1 },
        "props": { "$ref": "#/$defs/object" },
        "translations": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,11}$"
          },
          "additionalProperties": { "$ref": "#/$defs/object" }
        },
        "visibility": { "enum": ["visible", "hidden"] },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "extensions": { "$ref": "#/$defs/object" }
      },
      "additionalProperties": false
    }
  }
}
