{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/site-builder/export-v3.schema.json",
  "title": "Site Builder native export v3 with explicit UUID datasets",
  "type": "object",
  "required": [
    "format",
    "version",
    "source",
    "tables"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "laravel-site-builder/export"
    },
    "version": {
      "const": 3
    },
    "source": {
      "type": "object",
      "required": [
        "namespace",
        "application_timezone",
        "locales"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
        },
        "application_timezone": {
          "type": "string"
        },
        "locales": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "captured_at": {
          "type": "string"
        },
        "mapper_version": {
          "const": 1
        },
        "connection_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "application_name": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "maxItems": 100000,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[1-9][0-9]*$"
                },
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              ]
            }
          },
          "additionalProperties": true
        }
      },
      "properties": {
        "revisions": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "required": [
              "id",
              "created_by",
              "created_by_type"
            ],
            "properties": {
              "id": {
                "oneOf": [
                  {
                    "type": "string",
                    "pattern": "^[1-9][0-9]*$"
                  },
                  {
                    "type": "integer",
                    "minimum": 1
                  }
                ]
              },
              "created_by": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 191,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:@-]*$"
                  }
                ]
              },
              "created_by_type": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  }
                ]
              }
            },
            "additionalProperties": true
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
